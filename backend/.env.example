# =============================================================================
# AeroXe Broadband Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
#
# All variable names below match exactly what src/config/settings.rs (and the
# integration adapters) read at runtime.

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_ADDR=0.0.0.0:8000
APP_ENV=development            # development | staging | production
APP_NAME=AeroXe Broadband
# Public-facing base URL used to build links in emails/notifications
APP_PUBLIC_URL=http://localhost:8000

# ── Seed Data ────────────────────────────────────────────────────────────────
# Password for seeded staff users created by migration 029 (super_admin,
# isp_owner, network_admin, noc_engineer, field_technician, customer_support,
# sales_agent, finance_manager, billing_operator, customer — all @aeroxe.com).
# Falls back to `Aeroxe@123` when unset.
SEED_ADMIN_PASSWORD=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aeroxe:secret@localhost:5432/aeroxe
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_CONNECT_TIMEOUT_SECS=30
DB_IDLE_TIMEOUT_SECS=600

# ── Redis ───────────────────────────────────────────────────────────────────
# Password for docker-compose Redis service. Used in REDIS_URL below.
# SECURITY: Change this in production!
REDIS_PASSWORD=aeroxe_redis_secret
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ── NATS JetStream ──────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── JWT Authentication (RS256) ──────────────────────────────────────────────
# Generate RSA key pair:
#   openssl genrsa 2048 | openssl rsa -pubout
# In production BOTH keys are REQUIRED. If neither is set the backend falls
# back to ephemeral dev keys and rejects production startup.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Deprecated dev-only fallback (ignored when JWT_PRIVATE_KEY/PUBLIC_KEY are set)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECS=1800
JWT_REFRESH_TOKEN_TTL_SECS=604800
JWT_KEY_ROTATION_DAYS=90

# ── CORS Origins (comma-separated) ──────────────────────────────────────────
CORS_ORIGINS=https://aeroxebroadband.com,https://admin.aeroxe.com

# ── MinIO / S3 Object Storage ───────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_KYC=aeroxe-kyc
MINIO_BUCKET_INVOICES=aeroxe-invoices
MINIO_BUCKET_DOCUMENTS=aeroxe-documents

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true               # true = STARTTLS (587) / direct TLS (465); false = dev only
SMTP_FROM_NAME=AeroXe Broadband
SMTP_FROM_EMAIL=noreply@aeroxebroadband.com

# ── SMS Provider (MSG91) ────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AEROXE
MSG91_ROUTE=4                   # 4 = Transactional
MSG91_COUNTRY_CODE=91
MSG91_API_URL=https://api.msg91.com/api/v5/otp

# ── OTP Login Channels ───────────────────────────────────────────────────────
# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_API_URL=https://graph.facebook.com
# Telegram bot (from BotFather) — OTP via /login <phone>
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Firebase Cloud Messaging (OTP via push) — service account key JSON
FCM_SERVICE_ACCOUNT_KEY=
FCM_PROJECT_ID=
FCM_API_URL=https://fcm.googleapis.com/v1/projects

# ── Payment Gateways ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PayU (legacy gateway adapter)
PAYU_ENV=test                     # test | production
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Stripe gateway adapter
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── MikroTik Router (network automation) ────────────────────────────────────
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=
MIKROTIK_USE_SSL=false            # true = REST API over HTTPS (port 443)
MIKROTIK_ACCEPT_INVALID_CERTS=false
MIKROTIK_API_VERSION=v7

# ── Huawei OLT (SSH/GPON provisioning) ───────────────────────────────────────
HUAWEI_OLT_HOST=192.168.10.1
HUAWEI_OLT_PORT=22
HUAWEI_OLT_USERNAME=root
HUAWEI_OLT_PASSWORD=
HUAWEI_OLT_ENABLE_PASSWORD=
HUAWEI_OLT_FRAME_ID=0
HUAWEI_OLT_SLOT_ID=0
HUAWEI_OLT_PON_ID=0
HUAWEI_OLT_ONT_ID=0
HUAWEI_OLT_SSH_TIMEOUT=10

# ── RADIUS AAA ───────────────────────────────────────────────────────────────
# When RADIUS_SERVER is set, the accounting worker connects in active mode;
# otherwise it runs in passive mode.
RADIUS_SERVER=127.0.0.1
RADIUS_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
RADIUS_COA_PORT=3799
RADIUS_SECRET=
RADIUS_TIMEOUT=5
RADIUS_MAX_RETRIES=3
RADIUS_NAS_IP=127.0.0.1

# ── Twilio SMS (alternative to MSG91) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_URL=https://verify.twilio.com/v2

# ── Reverse Proxy Trust ─────────────────────────────────────────────────────
# Only set to true when the app sits behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Real-IP. Enables rate limiting / client IP extraction
# from those headers. Leaving false (default) ignores forwarded IPs.
TRUST_PROXY=false

# ── Docker Compose (backend/docker-compose.yml) ─────────────────────────────
# Host-port bindings used only by docker-compose; the app itself ignores these.
# Postgres/Redis/NATS/MinIO talk to each other over the internal bridge network.
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8000
FRONTEND_PORT=80
# SECURITY: Change ALL default passwords before deploying to production!
POSTGRES_PASSWORD=secret
REDIS_PASSWORD=aeroxe_redis_secret
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Tax / Compliance (GSTIN, TDS) ───────────────────────────────────────────
SUPPLIER_GSTIN=27AABCA1234H1Z5
SUPPLIER_STATE=Maharashtra
TDS_RATE_PROFESSIONAL=0.10
TDS_RATE_CONTRACTOR=0.02
TDS_PAN=

# ── Frontend Error Tracking (Sentry) ───────────────────────────────────────
# Set VITE_SENTRY_DSN in frontend/.env to enable error tracking in production
# VITE_SENTRY_DSN=https://your-key@sentry.io/project-id
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Logging ─────────────────────────────────────────────────────────────────
RUST_LOG=aeroxe_backend=debug,tower_http=debug

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=5
RATE_LIMIT_API_READ=100
RATE_LIMIT_API_WRITE=30
RATE_LIMIT_UPLOAD=10
# When set, the Prometheus /metrics endpoints require `Authorization: Bearer <token>`.
METRICS_TOKEN=

# ── Background Worker Poll Intervals (seconds) ──────────────────────────────
WORKER_OUTBOX_POLL_INTERVAL_SECS=5
WORKER_BILLING_POLL_INTERVAL_SECS=300
WORKER_NOTIFICATION_POLL_INTERVAL_SECS=30
WORKER_DEVICE_SYNC_POLL_INTERVAL_SECS=120
WORKER_BANDWIDTH_POLL_INTERVAL_SECS=60
WORKER_RADIUS_POLL_INTERVAL_SECS=300
WORKER_SCHEDULER_POLL_INTERVAL_SECS=30
WORKER_MONITORING_POLL_INTERVAL_SECS=120
WORKER_PARTITION_POLL_INTERVAL_SECS=86400
WORKER_OUTBOX_CLEANUP_POLL_INTERVAL_SECS=3600
