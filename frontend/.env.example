# =============================================================================
# AeroXe Broadband Frontend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables are read via import.meta.env.VITE_* at build time.
#
# NEVER commit .env to version control.

# ── API ─────────────────────────────────────────────────────────────────────
# Base URL of the backend API (no trailing /api). Defaults to the local dev
# backend when unset.
# Local dev: use /api (Vite proxy forwards to backend)
# Production/Docker: use full URL like https://api.aeroxebroadband.com/api
VITE_API_URL=/api

# ── App Environment ─────────────────────────────────────────────────────────
# Controls Sentry environment, feature flags, and build optimizations.
# Values: development | staging | production
VITE_APP_ENV=development

# ── Sentry Error Tracking ───────────────────────────────────────────────────
# DSN from your Sentry project settings. Leave empty to disable in dev.
# Required in production for error observability.
VITE_SENTRY_DSN=
# Sentry session replay sample rate (0.0 to 1.0). Default: 0.1 (10%).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
